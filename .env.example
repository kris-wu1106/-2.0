# ===== 服务基础配置 =====
PORT=4321
HOST=0.0.0.0
# 生产环境务必替换为随机长字符串：openssl rand -hex 32
JWT_SECRET=please-change-me

# ===== AI 服务（OpenAI 兼容协议）=====
# 不填 AI_API_KEY 时，问答自动降级为本地规章关键词匹配，功能不中断。
#
# 阿里云百炼 / 通义千问（推荐，服务器在阿里云时同地域延迟最低）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
#
# DeepSeek 示例
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
#
# Kimi 示例
# AI_BASE_URL=https://api.moonshot.cn/v1
# AI_MODEL=moonshot-v1-8k
#
# 自建 vLLM / Ollama（Ollama 需开启 OpenAI 兼容层）
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=qwen2.5:7b

# 生成参数
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.2
